# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luatvanich
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Lưu Trữ Tệp (Mặc định: Cloudinary) ─────────────────────────────────────────
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── MinIO / S3 (Tùy chọn khi đổi STORAGE_DRIVER=s3) ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=admin_minio
S3_SECRET_KEY=Password@2026!
S3_BUCKET_PUBLIC=luatvanich-public
S3_BUCKET_PRIVATE=luatvanich-private
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/luatvanich-public

# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Luật Vạn Ích <no-reply@luatvanich.vn>"

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true
